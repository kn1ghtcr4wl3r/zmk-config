#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>

&mt {
    tapping-term-ms = <200>;
    quick-tap-ms = <125>;
};

/ {
        behaviors {
                hm: homerow_mods {
                        compatible = "zmk,behavior-hold-tap";
                        label = "HOMEROW_MODS";
                        #binding-cells = <2>;
                        tapping-term-ms = <200>;
                        quick-tap-ms = <125>;
                        flavor = "balanced";
                        bindings = <&kp>, <&kp>;
                };
                th: thumb_hold_tap {
                        compatible = "zmk,behavior-hold-tap";
                        label = "THUMB_HOLD_TAP";
                        #binding-cells = <2>;
                        tapping-term-ms = <200>;
                        quick-tap-ms = <125>;
                        flavor = "balanced";
                        bindings = <&mo>, <&kp>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// Gallium Layout (Colstag) - Miryoku Style (34-key)
// |  B  |  L  |  D  |   C  |  V  |   |  J  |  Y   |  O  |  U  |  ,  |
// |  N  |  R  |  T  |   S  |  G  |   |  P  |  H   |  A  |  E  |  I  |
// |  X  |  Q  |  M  |   W  |  Z  |   |  K  |  F   |  ;  |  .  |  '  |
//             | ESC | SPCE | TAB |   | ENT | BSPC | DEL |
                        bindings = <
   &kp B           &kp L           &kp D           &kp C           &kp V               &kp J       &kp Y           &kp O           &kp U           &kp COMMA
   &hm LCTRL N     &hm LALT R      &hm LSHFT T     &hm LCMD S      &kp G               &kp P       &hm LCMD H      &hm LSHFT A     &hm LALT E      &hm LCTRL I
   &kp X           &kp Q           &kp M           &kp W           &kp Z               &kp K       &kp F           &kp SEMI        &kp DOT         &kp SQT
                             &th 1 ESC       &th 3 SPACE     &th 5 TAB       &th 6 RET           &th 2 BSPC     &th 4 DEL
                        >;
                };

                nav_layer {
// -----------------------------------------------------------------------------------------
// Navigation Layer
// |      |      |      |      |      |      |   | PGUP |  HOME |  UP  | END  |      |      |
// |      |      |      |      |      |      |   | PGDN |  LEFT | DOWN |RIGHT |      |      |
// |      |UNDO  | CUT  | COPY |PASTE |      |   | UNDO |  CUT  | COPY |PASTE |      |      |
//                      |      |      |      |   |      |       |      |
                        bindings = <
   &trans  &trans  &trans  &trans  &trans  &trans          &kp PG_UP  &kp HOME  &kp UP    &kp END    &trans     &trans
   &trans  &trans  &trans  &trans  &trans  &trans          &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &trans     &trans
   &trans  &kp LG(Z) &kp LG(X) &kp LG(C) &kp LG(V)          &kp LG(Z)   &kp LG(X) &kp LG(C) &kp LG(V)  &trans     &trans
                           &trans  &trans  &trans          &trans     &trans    &trans
                        >;
                };

                symbol_layer {
// -----------------------------------------------------------------------------------------
// Symbol Layer
// |  `   |  !   |  @   |  [   |  ]   |  "   |      |   |      |      |      |      |      |      |
// |  ~   |  #   |  $   |  (   |  )   |  :   |      |   |      |  /   |  <   |  =   |  >   |  -   |
// |  \   |  %   |  ^   |  {   |  }   |  _   |      |   |      |  *   |      |      |      |  +   |
//                       |  ?   |  &   |  |   |      |   |      |      |      |
                        bindings = <
   &kp GRAVE  &kp EXCL   &kp AT     &kp LBKT   &kp RBKT   &kp DQT        &trans   &trans     &trans     &trans     &trans     &trans     &trans     &trans
   &kp TILDE  &kp HASH   &kp DLLR   &kp LPAR   &kp RPAR   &kp COLON      &trans   &trans     &kp FSLH   &kp LT     &kp EQUAL  &kp GT     &kp MINUS  &trans
   &kp BSLH   &kp PRCNT  &kp CARET  &kp LBRC   &kp RBRC   &kp UNDER      &trans   &trans     &kp ASTRK  &trans     &trans     &trans     &kp PLUS   &trans
                                &kp QMARK  &kp AMPS   &kp PIPE       &trans   &trans   &mo 5
                        >;
                };

                numpad_layer {
// -----------------------------------------------------------------------------------------
// Numpad Layer
// |      |      |      |      |      |      |   |  =   |  7   |  8   |  9   | DEL  |      |
// |      |      |      |      |      |      |   |  /   |  4   |  5   |  6   |  -   |      |
// |      |      |      |      |      |      |   |  *   |  1   |  2   |  3   |  +   |      |
//                      |      |      |      |   | ENT  |  0   |  .   |
                        bindings = <
   &trans   &trans   &trans   &trans   &trans   &trans         &kp EQUAL  &kp N7   &kp N8   &kp N9   &kp DEL    &trans
   &trans   &trans   &trans   &trans   &trans   &trans         &kp FSLH   &kp N4   &kp N5   &kp N6   &kp MINUS  &trans
   &trans   &trans   &trans   &trans   &trans   &trans         &kp ASTRK  &kp N1   &kp N2   &kp N3   &kp PLUS   &trans
                                &trans     &trans     &trans         &kp RET    &kp N0   &kp DOT
                        >;
                };

                function_layer {
// -----------------------------------------------------------------------------------------
// Function Layer
// |  CAPS |  F9  | F10  | F11 | F12 |      |   | BT1  | BT2  | BT3  | BT4  | BT5  | BTCLR |
// |       |  F5  |  F6  |  F7 | F8  |      |   |      |      |      |      |      |
// |       |  F1  |  F2  |  F3 | F4  |      |   |      |      |      |      |      |      |
//                |      |     |     |      |   |      |      |
                        bindings = <
   &kp CAPS   &kp F9   &kp F10  &kp F11  &kp F12 &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_CLR 
   &trans     &kp F5   &kp F6   &kp F7   &kp F8  &trans       &trans       &trans       &trans       &trans       &trans
   &trans     &kp F1   &kp F2   &kp F3   &kp F4  &trans       &trans       &trans       &trans       &trans       &trans
                       &trans   &trans   &trans  &trans       &trans       &trans
                        >;
                };

                mouse_layer {
// -----------------------------------------------------------------------------------------
// Mouse Layer
// |      |      |      |      |      |      |   | SCRL_U| SCRL_L| MOVE_U| SCRL_R| BTN7 |      | 
// |      |      |      |      |      |      |   | SCRL_D| MOVE_L| MOVE_D| MOVE_R| BTN6 |      |
// |      |      |      |      |      |      |   |  BTN4 | LMB   | MCLK  | RMB   | BTN5 |      |
//                      |      |      |      |   |  LMB | MIDDLE| RMB  |
                        bindings = <
   &trans   &trans   &trans   &trans   &trans   &trans       &mwh SCROLL_UP    &mwh SCROLL_LEFT &mmv MOVE_UP   &mwh SCROLL_RIGHT &mkp BTN7     &trans
   &trans   &trans   &trans   &trans   &trans   &trans       &mwh SCROLL_DOWN  &mmv MOVE_LEFT   &mmv MOVE_DOWN &mmv MOVE_RIGHT   &mkp BTN6     &trans        
   &trans   &trans   &trans   &trans   &trans   &trans       &mkp BTN4         &mkp LCLK        &mkp MCLK      &mkp RCLK         &mkp BTN5     &trans
                                &trans     &trans     &trans       &mkp LCLK &mkp MCLK &mkp RCLK
                        >;
                };

                media_layer {
// -----------------------------------------------------------------------------------------
// Media Layer
// |      |      |      |      |      |      |   |      | BRI_DN | BRI_UP | EXPSE | LAUNCHPAD |      |
// |      |      |      |      |      |      |   |      | PREV | STOP | PLAY |NEXT  |
// |      |      |      |      |      |      |   |      | MUTE | VOLD | VOLU |      |      |
//                      |      |      |      |   |      |      |      |
                        bindings = <
   &trans   &trans   &trans   &trans   &trans   &trans       &trans   &kp C_BRI_DN &kp C_BRI_UP &kp C_EXPSE &kp C_LAUNCHPAD &trans
   &trans   &trans   &trans   &trans   &trans   &trans       &trans   &kp C_PREV   &kp C_STOP   &kp C_PLAY_PAUSE &kp C_NEXT &trans 
   &trans   &trans   &trans   &trans   &trans   &trans       &trans   &kp C_MUTE   &kp C_VOL_DN &kp C_VOL_UP     &trans     &trans
                                &trans     &trans     &trans       &trans   &trans   &trans
                        >;
                };
        };
};
