#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>

&mt {
    tapping-term-ms = <200>;
    quick-tap-ms = <125>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
//        th: thumb_hold_tap {
//            compatible = "zmk,behavior-hold-tap";
//            label = "THUMB_HOLD_TAP";
//            #binding-cells = <2>;
//            tapping-term-ms = <200>;
//            quick-tap-ms = <125>;
//            flavor = "balanced";
//            bindings = <&mo>, <&kp>;
//        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
/* outer */ &trans &kp B    &kp L    &kp D    &kp C    &kp V        &kp J    &kp Y    &kp O    &kp U    &kp COMMA &trans
/* home  */ &trans &hm LCTRL N &hm LALT R &hm LSHFT T &hm LCMD S &kp G     &kp P    &hm LCMD H &hm LSHFT A &hm LALT E &hm LCTRL I &trans
/* bottom*/ &trans &kp X    &kp Q    &kp M    &kp W    &kp Z        &kp K    &kp F    &kp SEMI &kp DOT  &kp SQT   &trans
//                        &th 1 ESC  &th 3 SPACE &th 5 TAB   &th 6 RET   &th 2 BSPC &th 4 DEL
                        &kp ESC  &kp SPACE &kp TAB   &kp RET   &kp BSPC &kp DEL
            >;
        };

