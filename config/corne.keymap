#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>

&mt {
    tapping-term-ms = <200>;
    quick-tap-ms = <125>;
};

/ {
        behaviors {
                hm: homerow_mods {
                        compatible = "zmk,behavior-hold-tap";
                        label = "HOMEROW_MODS";
                        #binding-cells = <2>;
                        tapping-term-ms = <200>;
                        quick-tap-ms = <125>;
                        flavor = "balanced";
                        bindings = <&kp>, <&kp>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// Gallium Layout (Colstag) - Miryoku Style (34-key)
// |  B  |  L  |  D  |  C  |  V  |   |  J  |  Y   |  O  |  U  |  ,  |
// |  N  |  R  |  T  |  S  |  G  |   |  P  |  H   |  A  |  E  |  I  |
// |  X  |  Q  |  M  |  W  |  Z  |   |  K  |  F   |  ;  |  .  |  /  |
//                |  BSPC | NAV | SPC |   | ENT | SYM  | NUM |
                        bindings = <
   &kp B           &kp L           &kp D           &kp C           &kp V               &kp J       &kp Y           &kp O           &kp U           &kp COMMA
   &hm LCTRL N     &hm LALT R      &hm LSHFT T     &hm LCMD S      &kp G               &kp P       &hm LCMD H      &hm LSHFT A     &hm LALT E      &hm LCTRL I
   &kp X           &kp Q           &kp M           &kp W           &kp Z               &kp K       &kp F           &kp SEMI        &kp DOT         &kp FSLH
                             &kp BSPC        &mo 1           &kp SPACE       &kp RET             &mo 2       &mo 3
                        >;
                };

                nav_layer {
// -----------------------------------------------------------------------------------------
// Miryoku Navigation Layer
// |      |      |      |      |      |      |   | PGUP |  HOME |  UP  | END  |      |      |
// |      |      |      |      |      |      |   | PGDN |  LEFT | DOWN | RIGHT|      |      |
// |      |      |      |      |      |      |   |      |       |      |      |      |      |
//                       |      |      |      |   |      |       |      |
                        bindings = <
   &trans  &trans  &trans  &trans  &trans  &trans          &kp PG_UP  &kp HOME  &kp UP    &kp END    &trans     &trans
   &trans  &trans  &trans  &trans  &trans  &trans          &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &trans     &trans
   &trans  &trans  &trans  &trans  &trans  &trans          &trans     &trans    &trans    &trans     &trans     &trans
                           &trans  &trans  &trans          &trans     &trans    &trans
                        >;
                };

                symbol_layer {
// -----------------------------------------------------------------------------------------
// Symbol Layer
// | TAB  |  !   |  @   |  #   |  $   |      |   |      |  %   |  ^   |  &   | ESC  |
// |      |  ^   |  &   |  *   |  (   |      |   |      |  )   |  -   |  =   |  '   |
// |      |  -   |  =   |  [   |  ]   |  `   |   |      |  {   |  }   |  |   |  ~   |
//                       |      |      |      |   |      |      |      |
                        bindings = <
   &kp TAB    &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &trans         &trans   &kp PRCNT  &kp CARET  &kp AMPS   &kp ESC
   &trans     &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR   &trans         &trans   &kp RPAR   &kp MINUS  &kp EQUAL  &kp SQT
   &trans     &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT   &kp GRAVE      &trans   &kp LBRC   &kp RBRC   &kp PIPE   &kp TILDE
                                &trans     &trans     &trans         &trans   &trans   &mo 5
                        >;
                };

                numpad_layer {
// -----------------------------------------------------------------------------------------
// 10-key Numpad Layer
// |      |      |      |      |      |      |   |  7   |  8   |  9   |  -   |      |      |
// |      |      |      |      |      |      |   |  4   |  5   |  6   |  +   |      |      |
// |      |      |      |      |      |      |   |  1   |  2   |  3   |      |      |      |
//                       |      |      |      |   |      |  0   | FUNC |
                        bindings = <
   &trans   &trans   &trans   &trans   &trans   &trans         &kp N7   &kp N8   &kp N9   &kp MINUS  &trans   &trans
   &trans   &trans   &trans   &trans   &trans   &trans         &kp N4   &kp N5   &kp N6   &kp PLUS   &trans   &trans
   &trans   &trans   &trans   &trans   &trans   &trans         &kp N1   &kp N2   &kp N3   &trans     &trans   &trans
                                &trans     &trans     &trans         &trans   &kp N0   &mo 4
                        >;
                };

                function_layer {
// -----------------------------------------------------------------------------------------
// Function & Bluetooth Layer
// | BTCLR| BT1  | BT2  | BT3  | BT4  | BT5  |   |  F1  |  F2  |  F3  |  F4  |      |      |
// |      |      |      |      |      |      |   |  F5  |  F6  |  F7  |  F8  |      |      |
// |      |      |      |      |      |      |   |  F9  |  F10 |  F11 |  F12 |      | MOUSE|
//                       |      |      |      |   |      |      |      |
                        bindings = <
   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp F1   &kp F2   &kp F3   &kp F4   &trans   &trans
   &trans     &trans       &trans       &trans       &trans       &trans         &kp F5   &kp F6   &kp F7   &kp F8   &trans   &trans
   &trans     &trans       &trans       &trans       &trans       &trans         &kp F9   &kp F10  &kp F11  &kp F12  &trans   &mo 5
                                    &trans       &trans       &trans         &trans   &trans   &trans
                        >;
                };

                mouse_layer {
// -----------------------------------------------------------------------------------------
// Mouse Layer
// |      |      |      |      |      |      |   |      |      |      |      |      |      |
// |      |      |      |      |      |      |   |      |  ◄   |  ▲   |  ►   | BTN1 | BTN2 |
// |      |      |      |      |      |      |   |      |      |  ▼   | WHUP | WHDN |      |
//                       |      |      |      |   |  LMB | MIDDLE| RMB  |
                        bindings = <
   &trans   &trans   &trans   &trans   &trans   &trans       &trans   &trans   &trans      &trans      &trans      &trans
   &trans   &trans   &trans   &trans   &trans   &trans       &trans   &mmv MOVE_LEFT &mmv MOVE_UP &mmv MOVE_RIGHT &mkp LCLK &mkp RCLK
   &trans   &trans   &trans   &trans   &trans   &trans       &trans   &trans   &mmv MOVE_DOWN  &mwh SCROLL_UP  &mwh SCROLL_DOWN &trans
                                &trans     &trans     &trans       &mkp LCLK &mkp MCLK &mkp RCLK
                        >;
                };
        };
};
